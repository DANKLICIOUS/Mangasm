# slay.llc — Void Market / The Grove (Appwrite)
# Copy to .env.local. Never commit real keys or CLI session tokens.

# Cloud endpoint includes the region, e.g. https://nyc.cloud.appwrite.io/v1
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Console project id after you create "slay.llc — Void Market / The Grove"
APPWRITE_PROJECT_ID=slay-llc-void-market

# Server API key (Console → Project settings → API keys).
# Scopes needed to push: tables, functions, storage, sites, teams, messaging.
# Never put this value in appwrite.config.json or commit it.
APPWRITE_API_KEY=

# TablesDB id declared in appwrite.config.json
APPWRITE_DATABASE_ID=grove

# Optional: Appwrite Sites hostname after first deploy
# APPWRITE_SITE_URL=https://the-grove-<project>.appwrite.network
