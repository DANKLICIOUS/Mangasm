# Mangasm Monorepo Environment Variables Example
# Copy to .env.local for local development. Never commit real secret keys.

# ==============================================================================
# Supabase Configuration
# ==============================================================================
SUPABASE_URL=https://dvomzrvslwdabwcwtvrg.supabase.co
SUPABASE_PROJECT_REF=dvomzrvslwdabwcwtvrg
# Live publishable / anon client key (safe for web client / Vercel public-config)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_ANON_KEY=sb_publishable_...

# Service role key (used ONLY for server-side admin or DB migrations — NEVER in client / Vercel)
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# Stripe Configuration (Set in Supabase Edge Functions via `supabase secrets set`)
# ==============================================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_1TyJDiGxbhrlkJVl4YOUgZat
STRIPE_PRICE_QUARTERLY=price_1TyJDsGxbhrlkJVlHDwNtO1Y
CHECKOUT_SUCCESS_URL=https://mangasm.app/plus/success
CHECKOUT_CANCEL_URL=https://mangasm.app/plus
# Optional: payment method configuration id (pmc_...)
STRIPE_PAYMENT_METHOD_CONFIGURATION=

# ==============================================================================
# Vercel Serverless / Waitlist Email (Set in Vercel Project Settings)
# ==============================================================================
RESEND_API_KEY=re_...
WAITLIST_NOTIFY_TO=bae@slay.llc
WAITLIST_FROM=Mangasm Rebuild <bae@slay.llc>
