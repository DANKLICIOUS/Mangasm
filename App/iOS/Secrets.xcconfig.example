// Copy to Secrets.xcconfig (git-ignored) OR run:
//   ./scripts/sync-secrets-from-mastermind.sh
// after setting MANGASM_SUPABASE_* in ~/mastermind-ai/secrets.env
//
// Xcode Cloud: do NOT commit Secrets.xcconfig. Set the same keys as Environment
// Variables; ci_scripts/ci_pre_xcodebuild.sh writes Secrets.xcconfig before archive.
// See docs/ship/XCODE-CLOUD-SECRETS.md
//
// Live project (2026-07-20): dvomzrvslwdabwcwtvrg
// NOTE: // starts a comment in xcconfig — $() below is required so the URL
// doesn't silently truncate to "https:".
SUPABASE_URL = https:/$()/dvomzrvslwdabwcwtvrg.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_YOUR_KEY
YELP_API_KEY = YOUR_YELP_API_KEY
TICKETMASTER_API_KEY = YOUR_TICKETMASTER_CONSUMER_KEY
